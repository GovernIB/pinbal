<?xml version="1.0" encoding="UTF-8"?>
<config xmlns="http://www.ehcache.org/v3"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.ehcache.org/v3 http://www.ehcache.org/schema/ehcache-core-3.0.xsd">

    <cache-template name="ttl-1h">
        <expiry><ttl unit="seconds">3600</ttl></expiry>
        <resources>
            <heap>100</heap>
        </resources>
    </cache-template>

    <cache-template name="ttl-24h">
        <expiry><ttl unit="seconds">86400</ttl></expiry>
        <resources>
            <heap>100</heap>
        </resources>
    </cache-template>

    <cache alias="serveiDescripcio" uses-template="ttl-1h"/>
    <cache alias="emisorNombre" uses-template="ttl-1h"/>
    <cache alias="clavePrivadaNombre" uses-template="ttl-1h"/>
    <cache alias="clavePrivadaNumeroSerie" uses-template="ttl-1h"/>
    <cache alias="clavePublicaNombre" uses-template="ttl-1h"/>
    <cache alias="clavePublicaNumeroSerie" uses-template="ttl-1h"/>

    <cache alias="procediments" uses-template="ttl-24h"/>
    <cache alias="serveis" uses-template="ttl-24h"/>
    <cache alias="serveisEntitat" uses-template="ttl-24h"/>
    <cache alias="serveisProcediment" uses-template="ttl-24h"/>
    <cache alias="dadesEspecifiques" uses-template="ttl-24h">
        <resources>
            <heap>300</heap>
        </resources>
    </cache>
    <cache alias="enumerats" uses-template="ttl-24h">
        <resources>
            <heap>300</heap>
        </resources>
    </cache>

    <cache alias="paisos" uses-template="ttl-24h"/>
    <cache alias="provincies" uses-template="ttl-24h"/>
    <cache alias="municipis" uses-template="ttl-24h"/>

    <cache alias="usuariAmbCodi" uses-template="ttl-24h">
        <resources>
            <heap>300</heap>
        </resources>
    </cache>
    <cache alias="usuariAmbNif" uses-template="ttl-24h">
        <resources>
            <heap>300</heap>
        </resources>
    </cache>
    <cache alias="serveiPermesosPerDelegat" uses-template="ttl-24h">
        <resources>
            <heap>300</heap>
        </resources>
    </cache>

    <!-- Equivalent a l'antic defaultCache (eternal) usat per Spring Security ACL -->
    <cache alias="aclCache">
        <expiry><none/></expiry>
        <resources>
            <heap>100</heap>
        </resources>
    </cache>

</config>