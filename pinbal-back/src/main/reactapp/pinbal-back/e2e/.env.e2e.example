# Copieu aquest fitxer a e2e/.env.e2e i ompliu els valors del vostre entorn.
# e2e/.env.e2e està afegit a .gitignore: no s'ha de pujar mai al repositori.

# URL base de l'aplicació PINBAL (JSP), NO la de l'app React d'aquest projecte.
# Exemple per a l'entorn aixecat amb `docker-compose up` a l'arrel del repo:
E2E_BASE_URL=http://localhost:8080/pinbalback

# Credencials Keycloak per a cada rol que es vulgui provar.
# Només cal emplenar els rols dels tests que es vulguin executar; els altres
# es marcaran automàticament com a "skipped".
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

E2E_DELEGAT_USERNAME=
E2E_DELEGAT_PASSWORD=

E2E_REPRESENTANT_USERNAME=
E2E_REPRESENTANT_PASSWORD=

E2E_AUDITOR_USERNAME=
E2E_AUDITOR_PASSWORD=

# Opcional: habilita el test de consulta simple contra el servidor fake de
# SCSP (pinbal-scsp-fake). Cal que els serveis SCSP coberts pel fake
# estiguin redirigits cap a ell (scripts/e2e/run-e2e.sh --point-scsp-urls) i
# que el codi indicat estigui assignat, amb el camp de document del titular
# actiu, a l'entitat del rol delegat. Vegeu e2e/README.md.
E2E_CONSULTA_SERVEI_CODI=
E2E_CONSULTA_PROCEDIMENT_ID=
