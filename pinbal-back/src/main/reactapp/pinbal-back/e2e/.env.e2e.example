# Copieu aquest fitxer a e2e/.env.e2e i ompliu els valors del vostre entorn.
# e2e/.env.e2e està afegit a .gitignore: no s'ha de pujar mai al repositori.

# URL base de l'aplicació PINBAL (JSP), NO la de l'app React d'aquest projecte.
# Exemple per a l'entorn aixecat amb `docker-compose up` a l'arrel del repo:
E2E_BASE_URL=http://localhost:8080/pinbalback

# Credencials Keycloak per a cada rol que es vulgui provar. Han de ser
# usuaris REALS del realm Keycloak compartit (AUTH_URL/AUTH_REALM de .env):
# scripts/e2e/run-e2e.sh reenvia els *_USERNAME (no les contrasenyes) com a
# paràmetres de Liquibase perquè la càrrega de dades de e2e
# (pinbal-persistence/.../db/changelog/e2e/) creï, a la BD H2 efímera que
# s'aixeca per a aquest flux, els registres Usuari/EntitatUsuari que fan que
# aquestes credencials tinguin el rol i l'accés a entitat esperats.
# Només cal emplenar els rols dels tests que es vulguin executar; els altres
# es marcaran automàticament com a "skipped".
E2E_ADMIN_USERNAME=
E2E_ADMIN_PASSWORD=

E2E_DELEGAT_USERNAME=
E2E_DELEGAT_PASSWORD=

E2E_REPRESENTANT_USERNAME=
E2E_REPRESENTANT_PASSWORD=

E2E_AUDITOR_USERNAME=
E2E_AUDITOR_PASSWORD=

# Codis d'usuaris "fixos" sembrats a la BD H2 per a proves de llistat/filtre/
# permisos que NO necessiten iniciar sessió amb aquell usuari (no calen
# contrasenyes ni comptes reals de Keycloak). Opcionals: si es deixen en
# blanc s'utilitzen els valors per defecte indicats. E2E_USER_ALL_ROLES es
# sembra amb els tres rols d'entitat (representant/delegat/auditor) actius.
E2E_USER_ACTIU_USERNAME=E2E_USER_ACTIU
E2E_USER_INACTIU_USERNAME=E2E_USER_INACTIU
E2E_USER_ALL_ROLES=pbl_all

# Opcional: habilita el test de consulta simple contra el servidor fake de
# SCSP (pinbal-scsp-fake). Amb el flux H2 (scripts/e2e/run-e2e.sh) NO cal cap
# pas manual: la càrrega de dades de e2e ja redirigeix aquests serveis cap al
# fake en arrencar. (Si s'executa contra un Oracle real en lloc del flux H2,
# cal redirigir-los manualment amb scripts/scsp-fake/point-to-fake.sql; vegeu
# FAKE_SCSP_SERVER.md.) Cal, en tot cas, que el codi indicat estigui
# assignat, amb el camp de document del titular actiu, a l'entitat del rol
# delegat. Vegeu e2e/README.md.
E2E_CONSULTA_SERVEI_CODI=
# E2E_CONSULTA_PROCEDIMENT_ID és l'id NUMÈRIC del procediment (p.ex. 900201
# per al procediment de mostra E2EPROC01), no el seu codi: és el valor que
# usa l'atribut `value` de les <option> del select #procedimentId
# (`optionValueAttribute="id"` a consultaForm.jsp).
E2E_CONSULTA_PROCEDIMENT_ID=
