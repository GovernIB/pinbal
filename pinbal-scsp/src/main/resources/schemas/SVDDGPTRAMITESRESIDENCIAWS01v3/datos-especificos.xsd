<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2011 sp1 (http://www.altova.com) by End User (free.org) -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos" targetNamespace="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="DatosEspecificos">
		<xs:complexType>
			<xs:choice>
				<xs:element ref="Consulta"/>
				<xs:element ref="Retorno"/>
			</xs:choice>
			<xs:attribute name="Id" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Consulta">
		<xs:annotation>
			<xs:documentation>Datos de consulta para el servicio</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:choice>
				<xs:element ref="NumeroSoporte"/>
				<xs:element ref="AnioNacimiento"/>
			</xs:choice>
		</xs:complexType>
	</xs:element>
	<!-- Consulta -->
	<xs:element name="NumeroSoporte">
		<xs:annotation>
			<xs:documentation>Número de soporte del documento del ciudadano extranjero a consultar</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="[E|C]\d{8}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Nombre">
		<xs:annotation>
			<xs:documentation>Nombre del titular consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="75"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Apellidos">
		<xs:annotation>
			<xs:documentation>Apellidos del titular consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="150"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NombrePadre">
		<xs:annotation>
			<xs:documentation>Nombre del padre del titular consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="75"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NombreMadre">
		<xs:annotation>
			<xs:documentation>Nombre de la madre del titular consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="75"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="AnioNacimiento">
		<xs:annotation>
			<xs:documentation>Año de nacimiento del titular consultado. Formato: YYYY</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:gYear">
				<xs:minInclusive value="1900"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaNacimiento">
		<xs:annotation>
			<xs:documentation>Fecha de nacimiento del titular consultado. Formato: YYYY-MM-DD / YYYY-MM / YYYY</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\d{4}-\d{2}-\d{2}|\d{4}-\d{2}|\d{4}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="LugarNacimiento">
		<xs:annotation>
			<xs:documentation>Lugar de nacimiento del titular consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="60"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CodigoPaisNacimiento">
		<xs:annotation>
			<xs:documentation>Código del pais de nacimiento del titular</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\d{3}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="PaisNacimiento">
		<xs:annotation>
			<xs:documentation>Pais de nacimiento del titular consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="75"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CodigoNacionalidad">
		<xs:annotation>
			<xs:documentation>Codigo de nacionalidad del titular</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\d{3}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Nacionalidad">
		<xs:annotation>
			<xs:documentation>Nacionalidad del titular de la consulta</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="75"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!-- Retorno -->
	<xs:element name="Retorno">
		<xs:annotation>
			<xs:documentation>Datos de retorno para servicio de consulta de vida Laboral</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element name="Estado">
					<xs:annotation>
						<xs:documentation>Estado de la respuesta</xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:all>
							<xs:element ref="CodigoEstado"/>
							<xs:element ref="CodigoEstadoSecundario" minOccurs="0"/>
							<xs:element ref="LiteralError"/>
						</xs:all>
					</xs:complexType>
				</xs:element>
				<xs:element ref="Titular" minOccurs="0"/>
				<xs:element ref="Residencias" minOccurs="0"/>
				<xs:element ref="DNINacionalizado" minOccurs="0"/>
				<xs:element ref="NIEUltimoSoporte" minOccurs="0"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="CodigoEstado">
		<xs:annotation>
			<xs:documentation>Codigo de estado de la transmisión</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="4"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CodigoEstadoSecundario">
		<xs:annotation>
			<xs:documentation>Codigo de estado secundario de la transmisión</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="LiteralError">
		<xs:annotation>
			<xs:documentation>Descripcion del estado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="1024"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Estado">
		<xs:annotation>
			<xs:documentation>Estado actual del documento</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="Codigo">
					<xs:annotation>
						<xs:documentation>Código del estado actual del documento</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Literal" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Estado actual del documento</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Fechas">
		<xs:complexType>
			<xs:sequence minOccurs="1" maxOccurs="unbounded">
				<xs:element ref="Fecha"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Fecha">
		<xs:annotation>
			<xs:documentation>Fecha del estado del documento</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element name="Estado">
					<xs:annotation>
						<xs:documentation>Código de estado en el que se encuentra el documento</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="50"/>
							<xs:whiteSpace value="collapse"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element ref="Literal">
					<xs:annotation>
						<xs:documentation>Estado en el que se encuentra el documento</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Fecha">
					<xs:annotation>
						<xs:documentation>Fecha del estado del documento. Formato: YYYY-MM-DD</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:date"/>
					</xs:simpleType>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="NIE">
		<xs:annotation>
			<xs:documentation>NIE del ciudadano dueño del documento</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="[XYZ]\d{7}[A-Z]"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="NIEUltimoSoporte">
		<xs:annotation>
			<xs:documentation>NIE asociado al último soporte del NIE consultado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="[XYZ]\d{7}[A-Z]"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DNINacionalizado">
		<xs:annotation>
			<xs:documentation>DNI del ciudadano dueño del documento en caso de nacionalizado</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:pattern value="\d{8}[A-Z]"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!-- Datos Titular -->
	<xs:element name="Titular">
		<xs:annotation>
			<xs:documentation>Datos del titular consultado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="NIE"/>
				<xs:element ref="Nombre"/>
				<xs:element ref="Apellidos" minOccurs="0"/>
				<xs:element ref="FechaNacimiento"/>
				<xs:element ref="CodigoPaisNacimiento"/>
				<xs:element ref="PaisNacimiento"/>
				<xs:element ref="CodigoNacionalidad"/>
				<xs:element ref="Nacionalidad"/>
				<xs:element ref="LugarNacimiento"/>
				<xs:element ref="NombrePadre" minOccurs="0"/>
				<xs:element ref="NombreMadre" minOccurs="0"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<!-- Residencias -->
	<xs:element name="Residencias">
		<xs:annotation>
			<xs:documentation>Lista de residencias del titular consultado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence minOccurs="1" maxOccurs="unbounded">
				<xs:element ref="Residencia"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Residencia">
		<xs:annotation>
			<xs:documentation>Datos de la residencia del ciudadano consultado</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="TipoTramite"/>
				<xs:element ref="FechaSolicitud" minOccurs="0"/>
				<xs:element ref="FechaConcesion" minOccurs="0"/>
				<xs:element ref="FechaDenegacion" minOccurs="0"/>
				<xs:element ref="FechaValidez" minOccurs="0"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="FechaSolicitud">
		<xs:annotation>
			<xs:documentation>Fecha de solicitud del periodo de residencia (trámite). Formato: YYYY-MM-DD</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaConcesion">
		<xs:annotation>
			<xs:documentation>Fecha de concesión del periodo de residencia (trámite). Formato: YYYY-MM-DD</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaDenegacion">
		<xs:annotation>
			<xs:documentation>Fecha de denegación del periodo de residencia (trámite). Formato: YYYY-MM-DD</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaValidez">
		<xs:annotation>
			<xs:documentation>Fecha de validez del periodo de residencia (trámite). Formato: YYYY-MM-DD</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Motivo">
		<xs:annotation>
			<xs:documentation>Motivo de concesión del trámite</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element name="Codigo" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Código del motivo de la concesión del trámite</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="3"/>
							<xs:whiteSpace value="collapse"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
				<xs:element name="Literal" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Descripción del motivo de la concesión del trámite</xs:documentation>
					</xs:annotation>
					<xs:simpleType>
						<xs:restriction base="xs:string">
							<xs:minLength value="1"/>
							<xs:maxLength value="180"/>
							<xs:whiteSpace value="collapse"/>
						</xs:restriction>
					</xs:simpleType>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="TipoTramite">
		<xs:annotation>
			<xs:documentation>Tipo trámite (residencia)</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:all>
				<xs:element ref="Codigo"/>
				<xs:element ref="Literal"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Codigo">
		<xs:annotation>
			<xs:documentation>Identificador interno del trámite</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="10"/>
				<xs:whiteSpace value="collapse"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Literal">
		<xs:annotation>
			<xs:documentation>Descripción de tipo trámite (residencia)</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="75"/>
				<xs:whiteSpace value="collapse"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<!-- Fin Residencias -->
</xs:schema>
