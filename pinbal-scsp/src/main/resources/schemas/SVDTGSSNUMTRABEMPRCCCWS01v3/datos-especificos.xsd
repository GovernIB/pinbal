<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos"
           attributeFormDefault="unqualified"
           elementFormDefault="qualified"
           targetNamespace="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos">
   <xs:element name="DatosEspecificos">
      <xs:complexType>
         <xs:choice>
            <xs:element ref="Consulta"/>
            <xs:element ref="Retorno"/>
         </xs:choice>
         <xs:attribute name="Id" type="xs:string" use="optional"/>
      </xs:complexType>
   </xs:element>
   <xs:element name="Consulta">
      <xs:complexType>
         <xs:all>
            <xs:element ref="FechaDesde"/>
            <xs:element ref="FechaHasta"/>
         </xs:all>
      </xs:complexType>
   </xs:element>
   <xs:element name="Retorno">
      <xs:annotation>
         <xs:documentation>Solo en el mensaje de Respuesta</xs:documentation>
      </xs:annotation>
      <xs:complexType>
         <xs:all>
            <xs:element ref="Estado"/>
            <xs:element ref="Resultado"/>
         </xs:all>
      </xs:complexType>
   </xs:element>
   <xs:element name="Estado">
      <xs:complexType>
         <xs:all>
            <xs:element ref="CodigoEstado">
               <xs:annotation>
                  <xs:documentation>Codigo de respuesta del servicio</xs:documentation>
               </xs:annotation>
            </xs:element>
            <xs:element minOccurs="0" ref="CodigoEstadoSecundario"/>
            <xs:element ref="LiteralError"/>
            <xs:element minOccurs="0" ref="LiteralErrorSecundario"/>
         </xs:all>
      </xs:complexType>
   </xs:element>
   <xs:element name="FechaDesde">
      <xs:simpleType>
         <xs:restriction base="xs:date"/>
      </xs:simpleType>
   </xs:element>
   <xs:element name="FechaHasta">
      <xs:simpleType>
         <xs:restriction base="xs:date"/>
      </xs:simpleType>
   </xs:element>
   <xs:element name="Resultado">
      <xs:complexType>
         <xs:all>
            <xs:element minOccurs="0" name="ListaDatosTrabCCC">
               <xs:complexType>
                  <xs:sequence>
                     <xs:element maxOccurs="unbounded" ref="DatosTrabCCC"/>
                  </xs:sequence>
               </xs:complexType>
            </xs:element>
         </xs:all>
      </xs:complexType>
   </xs:element>
   <xs:element name="DatosTrabCCC">
      <xs:complexType>
         <xs:all>
            <xs:element minOccurs="0" ref="CCC"/>
            <xs:element minOccurs="0" ref="CNAE"/>
            <xs:element minOccurs="0" ref="CodMutuaAT"/>
            <xs:element minOccurs="0" ref="CodMutuaIT"/>
            <xs:element minOccurs="0" ref="TRL"/>
            <xs:element minOccurs="0" ref="DomicilioActual"/>
            <xs:element minOccurs="0" ref="CodigoLocalidad"/>
            <xs:element minOccurs="0" ref="DescripcionLocalidad"/>
            <xs:element minOccurs="0" ref="CodigoPostal"/>
            <xs:element minOccurs="0" ref="NumTotTrabajadores"/>
            <xs:element minOccurs="0" ref="NumTotTrabajadoresDiscapacitados"/>
            <xs:element minOccurs="0" ref="NumTotTrabajadoresIndefinidosComp"/>
            <xs:element minOccurs="0" ref="NumTrabajadoresTParcial"/>
            <xs:element minOccurs="0" ref="NumTrabajadoresFijosDisc"/>
            <xs:element minOccurs="0" ref="NumTotTrabajadoresTempTComp"/>
            <xs:element minOccurs="0" ref="NumTotTrabajadoresTempTParcial"/>
            <xs:element minOccurs="0" ref="NumTotTrabajadoresHombres"/>
            <xs:element minOccurs="0" ref="NumTotTrabajadoresMujeres"/>
            <xs:element minOccurs="0" ref="FechaDesdeCCC"/>
            <xs:element minOccurs="0" ref="FechaHastaCCC"/>
         </xs:all>
      </xs:complexType>
   </xs:element>
   <xs:element name="CCC">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:length value="15"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="CNAE">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:length value="4"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="CodMutuaAT">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:length value="3"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="CodMutuaIT">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:length value="3"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="TRL">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="3"/>
            <xs:minLength value="1"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="DomicilioActual">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="54"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="CodigoLocalidad">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:length value="9"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="DescripcionLocalidad">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="40"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="CodigoPostal">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:length value="5"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="NumTotTrabajadores">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="NumTotTrabajadoresDiscapacitados">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="NumTotTrabajadoresIndefinidosComp">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="NumTrabajadoresTParcial">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="NumTrabajadoresFijosDisc">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="NumTotTrabajadoresTempTComp">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="NumTotTrabajadoresTempTParcial">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="NumTotTrabajadoresHombres">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="NumTotTrabajadoresMujeres">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="6"/>
            <xs:minLength value="0"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="FechaDesdeCCC">
      <xs:simpleType>
         <xs:restriction base="xs:date"/>
      </xs:simpleType>
   </xs:element>
   <xs:element name="FechaHastaCCC">
      <xs:simpleType>
         <xs:restriction base="xs:date"/>
      </xs:simpleType>
   </xs:element>
   <xs:element name="CodigoEstado">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="4"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="CodigoEstadoSecundario">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="16"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="LiteralError">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="1024"/>
            <xs:whiteSpace value="collapse"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
   <xs:element name="LiteralErrorSecundario">
      <xs:simpleType>
         <xs:restriction base="xs:string">
            <xs:maxLength value="1024"/>
         </xs:restriction>
      </xs:simpleType>
   </xs:element>
</xs:schema>
