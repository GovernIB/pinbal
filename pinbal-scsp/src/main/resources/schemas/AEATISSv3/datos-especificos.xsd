<xs:schema xmlns="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="DatosEspecificos">
		<xs:complexType>
			<xs:choice>
				<xs:element name="Ejercicio">
					<xs:simpleType>
						<xs:restriction base="xs:int"/>
					</xs:simpleType>
				</xs:element>
				<xs:sequence>
					<xs:element name="Cabecera">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="CodRet">
									<xs:simpleType>
										<xs:restriction base="xs:long">
											<xs:minInclusive value="0"/>
											<xs:maxInclusive value="9999"/>
											<xs:totalDigits value="4"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="DescripcionError">
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:minLength value="0"/>
											<xs:maxLength value="100"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="Referencia">
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:minLength value="0"/>
											<xs:maxLength value="11"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="FechaEmision">
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:minLength value="0"/>
											<xs:maxLength value="10"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
								<xs:element name="Ejercicio">
									<xs:simpleType>
										<xs:restriction base="xs:string">
											<xs:maxLength value="4"/>
											<xs:minLength value="0"/>
										</xs:restriction>
									</xs:simpleType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="DatosDeclaracion" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="NIF" type="xs:string"/>
								<xs:element name="NombreORazonSocial" type="xs:string"/>
								<xs:element name="TipoEjercicio"/>
								<xs:element name="CNAEActividadPrincipal"/>
								<xs:element name="CaracteresDeclaracion">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="Caracter" minOccurs="0" maxOccurs="unbounded"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="PersonalAsalariado">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="PersonalFijo"/>
											<xs:element name="PersonalNoFijo"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="GrupoFiscal" minOccurs="0">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="Numero"/>
											<xs:element name="NIF"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="GrupoMercantil" minOccurs="0">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="NIFMatriz"/>
											<xs:element name="CodPaisMatriz"/>
											<xs:element name="NombreMatriz"/>
											<xs:element name="PaisJurisdiccionMatriz"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="RepresentantesLegales" minOccurs="0">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="RepresentanteLegal" minOccurs="0" maxOccurs="3">
												<xs:complexType>
													<xs:sequence>
														<xs:element name="NIF" type="xs:string"/>
														<xs:element name="Nombre" type="xs:string"/>
													</xs:sequence>
												</xs:complexType>
											</xs:element>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
								<xs:element name="Administradores" minOccurs="0">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="Administrador" minOccurs="0" maxOccurs="unbounded">
												<xs:complexType>
													<xs:sequence>
														<xs:element name="NIF" type="xs:string"/>
														<xs:element name="Nombre" type="xs:string"/>
													</xs:sequence>
												</xs:complexType>
											</xs:element>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="EntidadesParticipadas" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="Entidad" minOccurs="0" maxOccurs="unbounded">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="NIF" type="xs:string"/>
											<xs:element name="NombreORazonSocial" type="xs:string"/>
											<xs:element name="Porcentaje" type="xs:string"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="EntidadesParticipantes" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="Entidad" minOccurs="0" maxOccurs="unbounded">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="NIF" type="xs:string"/>
											<xs:element name="NombreORazonSocial" type="xs:string"/>
											<xs:element name="Porcentaje" type="xs:string"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="Balance" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="Casilla" maxOccurs="unbounded">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="NumeroCasilla" type="xs:string"/>
											<xs:element name="Importe" type="xs:decimal"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
					<xs:element name="Liquidacion" minOccurs="0">
						<xs:complexType>
							<xs:sequence>
								<xs:element name="Casilla" maxOccurs="unbounded">
									<xs:complexType>
										<xs:sequence>
											<xs:element name="NumeroCasilla" type="xs:string"/>
											<xs:element name="Importe" type="xs:decimal"/>
										</xs:sequence>
									</xs:complexType>
								</xs:element>
							</xs:sequence>
						</xs:complexType>
					</xs:element>
				</xs:sequence>
			</xs:choice>
			<xs:attribute name="Id" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
</xs:schema>
