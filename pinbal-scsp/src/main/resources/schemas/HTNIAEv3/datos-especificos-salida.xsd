<?xml version="1.0" encoding="UTF-8"?>
<!-- edited with XMLSpy v2011 sp1 (http://www.altova.com) by End User (free.org) -->
<xs:schema xmlns="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos" elementFormDefault="qualified" attributeFormDefault="unqualified">
	<xs:element name="DatosEspecificos">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="Cabecera">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="CodRet">
								<xs:annotation>
									<xs:documentation>Código con el resultado. 
0 – Titular identificado y con actividades económicas
1 - Titular no identificado en la Hacienda Navarra. Revise datos identificativos del contribuyente
2 – Titular identificado y sin actividades económicas. </xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:long">
										<xs:minInclusive value="0"/>
										<xs:maxInclusive value="9999"/>
										<xs:totalDigits value="4"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="DescripcionError">
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="0"/>
										<xs:maxLength value="100"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Referencia">
								<xs:annotation>
									<xs:documentation>Referencia única de la respuesta. 
Siempre tendrá valor “0”</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="0"/>
										<xs:maxLength value="11"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="FechaEmision">
								<xs:annotation>
									<xs:documentation>Fecha de proceso en formato AAAA-MM-DD</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:minLength value="0"/>
										<xs:maxLength value="10"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Ejercicio">
								<xs:annotation>
									<xs:documentation>Ejercicio del cual se han facilitado los datos en formato AAAA</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="4"/>
										<xs:minLength value="0"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="ActividadesAlta" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Ejercicio">
								<xs:annotation>
									<xs:documentation>Ejercicio del que se van a reflejar las actividades que están de alta en él. Formato AAAA</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="4"/>
										<xs:minLength value="0"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Actividad" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element ref="CodigoEpigrafe">
											<xs:annotation>
												<xs:documentation>Código del epígrafe del IAE. </xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="Denominacion">
											<xs:annotation>
												<xs:documentation>Descripción de la actividad económica. </xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="TipoActividad" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Sección o tipo de actividad. 
- Empresarial.
- Profesional.
- Artista.
- Actividades económicas no sujetas al IAE.
</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="TipoCuota" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Ámbito de la actividad. 
- Nacional.
- Provincial.
- Municipal.
</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="FechaAlta">
											<xs:annotation>
												<xs:documentation>Fecha de alta en la actividad en formato DD/MM/AAAA.</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="ExencionConcedida" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Artículo por el que ha sido concedida la exención.</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:choice minOccurs="0">
											<xs:element ref="LocalIndirectamenteAfecto" minOccurs="0">
												<xs:annotation>
													<xs:documentation>Domicilio del local indirectamente afecto.</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element ref="DomicilioDesarrolloActividad" minOccurs="0">
												<xs:annotation>
													<xs:documentation>Domicilio en el que se desarrolla la actividad.</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element ref="MunicipioDesarrolloActividad" minOccurs="0">
												<xs:annotation>
													<xs:documentation>Municipio en el que se desarrolla la actividad.</xs:documentation>
												</xs:annotation>
											</xs:element>
										</xs:choice>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
				<xs:element name="ActividadesBaja" minOccurs="0">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="Ejercicio">
								<xs:annotation>
									<xs:documentation>Ejercicio del que se van a reflejar las actividades que están de baja en él. Formato AAAA</xs:documentation>
								</xs:annotation>
								<xs:simpleType>
									<xs:restriction base="xs:string">
										<xs:maxLength value="4"/>
										<xs:minLength value="0"/>
									</xs:restriction>
								</xs:simpleType>
							</xs:element>
							<xs:element name="Actividad" maxOccurs="unbounded">
								<xs:complexType>
									<xs:sequence>
										<xs:element ref="CodigoEpigrafe">
											<xs:annotation>
												<xs:documentation>Código del epígrafe del IAE. </xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="Denominacion">
											<xs:annotation>
												<xs:documentation>Descripción de la actividad económica. </xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="TipoActividad" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Sección o tipo de actividad. 
- Empresarial.
- Profesional.
- Artista.
- Actividades económicas no sujetas al IAE.</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="TipoCuota" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Ámbito de la actividad. 
- Nacional.
- Provincial.
- Municipal.</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="FechaAlta">
											<xs:annotation>
												<xs:documentation>Fecha de alta en la actividad en formato DD/MM/AAAA.</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="FechaCese">
											<xs:annotation>
												<xs:documentation>Fecha de cese de la actividad en formato DD/MM/AAAA.</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:element ref="ExencionConcedida" minOccurs="0">
											<xs:annotation>
												<xs:documentation>Artículo por el que ha sido concedida la exención.</xs:documentation>
											</xs:annotation>
										</xs:element>
										<xs:choice minOccurs="0">
											<xs:element ref="LocalIndirectamenteAfecto" minOccurs="0">
												<xs:annotation>
													<xs:documentation>Domicilio del local indirectamente afecto.</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element ref="DomicilioDesarrolloActividad" minOccurs="0">
												<xs:annotation>
													<xs:documentation>Domicilio en el que se desarrolla la actividad.</xs:documentation>
												</xs:annotation>
											</xs:element>
											<xs:element ref="MunicipioDesarrolloActividad" minOccurs="0">
												<xs:annotation>
													<xs:documentation>Municipio en el que se desarrolla la actividad.</xs:documentation>
												</xs:annotation>
											</xs:element>
										</xs:choice>
									</xs:sequence>
								</xs:complexType>
							</xs:element>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
			<xs:attribute name="Id" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="CodigoEpigrafe">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="0"/>
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Denominacion">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
				<xs:minLength value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TipoActividad">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="20"/>
				<xs:minLength value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TipoCuota">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="50"/>
				<xs:minLength value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaAlta">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="10"/>
				<xs:minLength value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaCese">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="10"/>
				<xs:minLength value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ExencionConcedida">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="30"/>
				<xs:minLength value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="LocalIndirectamenteAfecto">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="0"/>
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DomicilioDesarrolloActividad">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
				<xs:minLength value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="MunicipioDesarrolloActividad">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="100"/>
				<xs:minLength value="0"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>
