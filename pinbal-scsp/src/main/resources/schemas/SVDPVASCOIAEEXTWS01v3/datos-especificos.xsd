<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<xs:schema xmlns="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos" xmlns:xs="http://www.w3.org/2001/XMLSchema" targetNamespace="http://intermediacion.redsara.es/scsp/esquemas/datosespecificos" elementFormDefault="qualified" version="1.0">
	<xs:element name="DatosEspecificos">
		<xs:complexType>
			<xs:choice>
				<xs:element ref="Consulta"/>
				<xs:element ref="Retorno"/>
			</xs:choice>
			<xs:attribute name="Id" type="xs:string" use="optional"/>
		</xs:complexType>
	</xs:element>
	<xs:element name="Consulta">
		<xs:complexType>
			<xs:all>
				<xs:element ref="Provincia"/>
				<xs:element ref="Ejercicio"/>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="Retorno">
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Estado"/>
				<xs:element ref="DatosConsultados" minOccurs="1"/>
				<xs:element ref="ActividadesAlta" minOccurs="0"/>
				<xs:element ref="ActividadesBaja" minOccurs="0"/>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="Estado">
		<xs:complexType>
			<xs:all>
				<xs:element ref="CodigoEstado">
					<xs:annotation>
						<xs:documentation>Codigo de respuesta del servicio</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="CodigoEstadoSecundario" minOccurs="0">
					<xs:annotation>
						<xs:documentation>Contine un código más específico, que en caso de error puede aportar informacion necesaria para resolver la incidencia.</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="LiteralError">
					<xs:annotation>
						<xs:documentation>Descripción de la Respuesta, en función del valor del campo CodigoEstado.</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="DatosConsultados">
		<xs:complexType>
			<xs:all>
				<xs:element ref="Provincia">
					<xs:annotation>
						<xs:documentation>Código de la provincia de la que se ha realizado la consulta. 
01 - Araba/Álava
20 - Gipuzkoa
48 - Bizkaia</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element ref="Ejercicio">
					<xs:annotation>
						<xs:documentation>Ejercicio del cual se han consultado los datos</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:all>
		</xs:complexType>
	</xs:element>
	<xs:element name="ActividadesAlta">
		<xs:annotation>
			<xs:documentation>Lista de actividades dadas de alta</xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Ejercicio"/>
				<xs:element name="Actividad" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Datos de la actividad dada de baja </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="CodigoEpigrafe" minOccurs="0"/>
							<xs:element ref="Denominacion"/>
							<xs:element ref="TipoActividad" minOccurs="0"/>
							<xs:element ref="TipoCuota" minOccurs="0"/>
							<xs:element ref="FechaAlta"/>
							<xs:element ref="ExencionConcedida" minOccurs="0"/>
							<xs:element ref="LocalIndirectamenteAfecto" minOccurs="0"/>
							<xs:element ref="DomicilioDesarrolloActividad" minOccurs="0"/>
							<xs:element ref="MunicipioDesarrolloActividad" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="ActividadesBaja">
		<xs:annotation>
			<xs:documentation>Lista de actividades dadas de baja </xs:documentation>
		</xs:annotation>
		<xs:complexType>
			<xs:sequence>
				<xs:element ref="Ejercicio"/>
				<xs:element name="Actividad" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation>Datos de la actividad dada de baja </xs:documentation>
					</xs:annotation>
					<xs:complexType>
						<xs:sequence>
							<xs:element ref="CodigoEpigrafe" minOccurs="0"/>
							<xs:element ref="Denominacion"/>
							<xs:element ref="TipoActividad" minOccurs="0"/>
							<xs:element ref="TipoCuota" minOccurs="0"/>
							<xs:element ref="FechaAlta"/>
							<xs:element ref="FechaCese"/>
							<xs:element ref="ExencionConcedida" minOccurs="0"/>
							<xs:element ref="LocalIndirectamenteAfecto" minOccurs="0"/>
							<xs:element ref="DomicilioDesarrolloActividad" minOccurs="0"/>
							<xs:element ref="MunicipioDesarrolloActividad" minOccurs="0"/>
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
	<xs:element name="CodigoEpigrafe">
		<xs:annotation>
			<xs:documentation>Código del epígrafe del IAE. </xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="10"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Denominacion">
		<xs:annotation>
			<xs:documentation>Descripción de la actividad económica. </xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="255"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TipoActividad">
		<xs:annotation>
			<xs:documentation>Sección o tipo de actividad. 
- Empresarial.
- Profesional.
- Artista.
</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="Empresarial"/>
				<xs:enumeration value="Profesional"/>
				<xs:enumeration value="Artista"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="TipoCuota">
		<xs:annotation>
			<xs:documentation>Ámbito de la actividad. 
- Nacional.
- Provincial.
- Municipal.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="Nacional"/>
				<xs:enumeration value="Provincial"/>
				<xs:enumeration value="Municipal"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaAlta">
		<xs:annotation>
			<xs:documentation>Fecha de alta en la actividad en formato AAAA-MM-DD</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="FechaCese">
		<xs:annotation>
			<xs:documentation>Fecha de cese en la actividad en formato AAAA-MM-DD</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:date"/>
		</xs:simpleType>
	</xs:element>
	<xs:element name="ExencionConcedida">
		<xs:annotation>
			<xs:documentation>Artículo por el que ha sido concedida la exención.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="LocalIndirectamenteAfecto">
		<xs:annotation>
			<xs:documentation>Domicilio del local indirectamente afecto.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="150"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="DomicilioDesarrolloActividad">
		<xs:annotation>
			<xs:documentation>Domicilio en el que se desarrolla la actividad.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="150"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="MunicipioDesarrolloActividad">
		<xs:annotation>
			<xs:documentation>Municipio en el que se desarrolla la actividad.</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="100"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Ejercicio">
		<xs:annotation>
			<xs:documentation>Ejercicio del cual se han facilitado los datos en formato AAAA</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:gYear">
				<xs:minInclusive value="2011"/>
				<xs:pattern value="\d{4}"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="Provincia">
		<xs:annotation>
			<xs:documentation>Código de la provincia a la que se realizará la consulta. 
01 - Araba/Álava
20 - Gipuzkoa
48 - Bizkaia
</xs:documentation>
		</xs:annotation>
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:enumeration value="01"/>
				<xs:enumeration value="20"/>
				<xs:enumeration value="48"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CodigoEstado">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="4"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="CodigoEstadoSecundario">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:maxLength value="16"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
	<xs:element name="LiteralError">
		<xs:simpleType>
			<xs:restriction base="xs:string">
				<xs:minLength value="1"/>
				<xs:maxLength value="1024"/>
				<xs:whiteSpace value="collapse"/>
			</xs:restriction>
		</xs:simpleType>
	</xs:element>
</xs:schema>
