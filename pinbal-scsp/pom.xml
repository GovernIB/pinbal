	<build>
		<resources>
			<resource>
				<directory>src/main/resources</directory>
				<filtering>false</filtering>
			</resource>
		</resources>
		<plugins>
			<!-- Patcheja scsp-core.jar a local-repo/ i ~/.m2/ eliminant les classes
			     que pinbal-scsp sobreescriu (detectades dinàmicament dels fonts).
			     Fase initialize: s'executa abans de qualsevol compilació i per tant
			     afecta a tots els builds: EAR, Spring Boot directe i tests. -->
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>exec-maven-plugin</artifactId>
				<version>3.1.0</version>
				<executions>
					<execution>
						<id>patch-scsp-core-in-local-repo</id>
						<phase>initialize</phase>
						<goals><goal>exec</goal></goals>
						<configuration>
							<executable>python3</executable>
							<arguments>
								<argument>${project.basedir}/src/main/scripts/patch-scsp-local-repo.py</argument>
								<argument>${project.basedir}/src/main/java</argument>
								<argument>${project.basedir}/../local-repo</argument>
							</arguments>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.jacoco</groupId>
				<artifactId>jacoco-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>jacoco-prepare-agent</id>
						<configuration>
							<excludes>
								<exclude>es.scsp.*</exclude>
								<exclude>org.apache.axis2.*</exclude>
							</excludes>
						</configuration>
					</execution>
					<execution>
						<id>jacoco-report</id>
						<configuration>
							<excludes>
								<exclude>es/scsp/**</exclude>
								<exclude>org/apache/axis2/**</exclude>
								<exclude>axis2/**</exclude>
							</excludes>
						</configuration>
					</execution>
					<execution>
						<id>jacoco-check</id>
						<configuration>
							<excludes>
								<exclude>es/scsp/**</exclude>
								<exclude>org/apache/axis2/**</exclude>
								<exclude>axis2/**</exclude>
							</excludes>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
	<repositories>
		<repository>
			<id>mvn-local-repo</id>
			<url>file://${basedir}/../local-repo</url>
		</repository>
